# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소에 올리지 않는다.
FINNHUB_API_KEY=
# 쉬운 설명·호재 판단·전망 (Claude API). 없으면 그 기능만 건너뛴다.
ANTHROPIC_API_KEY=
# SEC 13F 수집용 연락처 (SEC 요구사항). 예: my-app name@example.com
SEC_USER_AGENT=
# 수집기 호출 속도 (기본 45/분, 무료 플랜 한도 60/분)
# FINNHUB_RPM=45
# 분석 모델을 바꿀 때 (기본값은 config/settings.yaml)
# LLM_MODEL=claude-sonnet-5-5
